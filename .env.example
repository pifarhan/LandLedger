# Copy to .env and replace each secret before running.
NODE_ENV=development
PORT=5000
DATABASE_MODE=mock
POSTGRES_DB=land_records
POSTGRES_USER=land_user
POSTGRES_PASSWORD=replace-with-a-strong-local-database-password
POSTGRES_URL=
JWT_SECRET=replace-with-at-least-32-random-characters-before-running
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
FABRIC_MODE=mock
UPLOAD_DIR=server/uploads

# Optional. Creates only an organisation-provisioned authority account.
# It never creates demo users or sample properties.
BOOTSTRAP_AUTHORITY_NAME=
BOOTSTRAP_AUTHORITY_EMAIL=
BOOTSTRAP_AUTHORITY_PASSWORD=


# Fabric mode: application-service certificate must have role=application-service.
# Authority certificate must have role=authority. Both are separate identities.
FABRIC_IDENTITY_CERT=
FABRIC_IDENTITY_KEY_DIR=
FABRIC_AUTHORITY_IDENTITY_CERT=
FABRIC_AUTHORITY_IDENTITY_KEY_DIR=
FABRIC_AUTHORITY_MSP_ID=
FABRIC_TLS_CERT=
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_CHANNEL=landchannel
FABRIC_CHAINCODE=landrecords
FABRIC_MSP_ID=Org1MSP
FABRIC_TLS_SERVER_NAME=peer0.org1.example.com
# Required: >=32 random bytes; used to HMAC personal/parcel references before channel submission.
FABRIC_REFERENCE_HMAC_SECRET=

# Optional: RBIH/ULI Next-Gen Land Records Service (requires approved institutional onboarding)
# Do not commit real credentials. Configure only after IP whitelisting and service subscription.
RBIH_LRS_ENABLED=false
RBIH_LRS_BASE_URL=
RBIH_LRS_CLIENT_ID=
RBIH_LRS_BEARER_TOKEN=
RBIH_LRS_CONSENT_ID=
RBIH_LRS_SCOPE=1
RBIH_LRS_QUERY_PATH=/api/v1/land-records/query
RBIH_LRS_REQUEST_PATH=/api/v1/land-records/requests
RBIH_LRS_TIMEOUT_MS=15000

# Optional: India Property Register third-party on-demand parcel lookup (not a government API)
# API key is billed per successful call by the provider. Never expose this key to the browser.
IPR_API_KEY=
IPR_API_TIMEOUT_MS=15000
